# =============================================================================
# Environment variable lollm
#
# File ini untuk pemakaian lokal (`node scripts/dev-server.mjs`) dan sebagai
# daftar acuan saat mengisi Environment Variables di dashboard Vercel.
#
# PENTING: Vercel TIDAK membaca file .env dari repository. Nilai untuk produksi
# diambil dari Project Settings -> Environment Variables (ke-26 kunci di bawah
# sudah terdaftar di sana, target production + preview + development).
#
# File ini hanya berisi kunci dan nilai default, jadi aman di-commit. Jangan
# menaruh kredensial asli di sini: simpan di .env.local (di-ignore) atau
# langsung di dashboard Vercel.
#
# Nilai yang sudah ada = default aman yang dipakai kode.
# Nilai yang kosong = wajib kamu isi sendiri (kredensial / identitas storage).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Mesin model (node-llama-cpp / llama.cpp)
# -----------------------------------------------------------------------------
# Jangan unduh / build binary saat npm install di Vercel (sudah ada paket prebuilt).
NODE_LLAMA_CPP_SKIP_DOWNLOAD=true
NODE_LLAMA_CPP_POSTINSTALL=skip
# Serverless tidak punya GPU.
NODE_LLAMA_CPP_GPU=false

# -----------------------------------------------------------------------------
# 2. Sumber model (dipakai lib/model-storage.mjs)
# -----------------------------------------------------------------------------
# auto   : s3 -> blob -> url -> huggingface (fallback berurutan)
# s3     : hanya bucket S3
# blob   : hanya Vercel Blob
# url    : hanya LLM_MODEL_BASE_URL
# huggingface : hanya Hugging Face
LLM_MODEL_SOURCE=auto

# Base URL publik yang menyajikan <id-model>.gguf (dipakai mode "url").
LLM_MODEL_BASE_URL=

# Folder cache model di disk function. Kosong = os.tmpdir()/vercel-local-llm-models
LLM_MODELS_DIR=

# -----------------------------------------------------------------------------
# 2b. Panjang konteks & keluaran (lib/model-limits.mjs)
#     Jawaban panjang butuh konteks besar; sesuaikan bila function kehabisan RAM.
# -----------------------------------------------------------------------------
# Ukuran konteks (token). Default 8192; batas atas 16384. Kosong/0 = pakai
# default (model >= 700 MB otomatis dibatasi 4096 agar tidak OOM).
LLM_CONTEXT_SIZE=8192

# Batas token keluaran per jawaban. Default 3072; batas atas 8192. Nilai efektif
# juga dibatasi sisa konteks (maksimum = konteks - 25% untuk prompt).
LLM_MAX_OUTPUT_TOKENS=3072

# -----------------------------------------------------------------------------
# 3. Storage S3-compatible (WAJIB untuk tab Model Store: simpan & hapus)
#    Bisa AWS S3, Cloudflare R2, Backblaze B2, MinIO, Supabase, Wasabi.
# -----------------------------------------------------------------------------
# Nama bucket, mis. lollm-models
LLM_S3_BUCKET=

# Region bucket. AWS: mis. ap-southeast-2 (atau iad1 agar dekat function).
# R2: "auto". MinIO: bebas, mis. us-east-1.
LLM_S3_REGION=

# Endpoint kustom. Kosongkan untuk AWS S3.
# R2   : https://<account-id>.r2.cloudflarestorage.com
# MinIO: http://host:9000
LLM_S3_ENDPOINT=

# Kredensial. Untuk R2/AWS gunakan access key yang hanya boleh baca/tulis bucket ini.
LLM_S3_ACCESS_KEY_ID=
LLM_S3_SECRET_ACCESS_KEY=
# Hanya untuk kredensial sementara (STS / role). Kosongkan bila tidak dipakai.
LLM_S3_SESSION_TOKEN=

# Prefix objek di dalam bucket. Objek model akan berada di <prefix><file>.gguf
LLM_S3_PREFIX=models/

# true untuk R2 / MinIO / endpoint yang tidak mendukung virtual-host style.
# Kosong = otomatis (path-style bila LLM_S3_ENDPOINT diisi).
LLM_S3_FORCE_PATH_STYLE=

# Isi bila objek disajikan lewat CDN / domain publik (tanpa tanda tangan).
# Kosong = memakai presigned URL SigV4.
LLM_S3_PUBLIC_BASE_URL=

# Masa berlaku presigned URL (detik). Rentang 60..604800.
LLM_S3_PRESIGN_TTL=900

# -----------------------------------------------------------------------------
# 4. Vercel Blob (alternatif S3; hanya untuk baca)
#    SDK Vercel Blob belum menyediakan list/hapus, jadi tab Model Store
#    (simpan/hapus) hanya aktif bila S3 dikonfigurasi.
# -----------------------------------------------------------------------------
# Base URL store Blob. Boleh dikosongkan: nilainya diturunkan otomatis dari
# BLOB_STORE_ID (atau segmen ke-4 BLOB_READ_WRITE_TOKEN) menjadi
# https://<store-id>.public.blob.vercel-storage.com (+ host .private sebagai cadangan).
LLM_BLOB_BASE_URL=
# true bila store disetel privat (dipakai token baca saat unduh).
LLM_BLOB_PRIVATE=

# -----------------------------------------------------------------------------
# 5. Tool calling & connector
# -----------------------------------------------------------------------------
# Jumlah maksimum putaran tool per request chat.
LLM_TOOL_MAX_ROUNDS=3

# Daftar host yang boleh diakses tool http_fetch (dipisah koma), mis.
# example.com,api.github.com  — kosong = tidak ada host yang diizinkan.
LLM_TOOL_HTTP_ALLOW_HOSTS=

# Nama tool yang dimatikan (dipisah koma), mis. http_fetch,calculate
LLM_TOOLS_DISABLED=

# "disabled" untuk mematikan endpoint pemanggilan tool langsung.
LLM_TOOLS_DIRECT_INVOKE=

# JSON array definisi connector kustom (lihat README bagian Connector).
# Contoh: [{"name":"cuaca","base_url":"https://api.example.com","allowed_hosts":["api.example.com"]}]
LLM_CONNECTORS=

# -----------------------------------------------------------------------------
# 6. UTCP (Universal Tool Calling Protocol)
# -----------------------------------------------------------------------------
# JSON manual UTCP yang didaftarkan langsung lewat env.
# Contoh: [{"name":"cuaca_demo","call_template_type":"http","tools":[...]}]
LLM_UTCP_MANUALS=

# Template transport "file" hanya aktif bila disetel true.
LLM_UTCP_ALLOW_FILE=false
# Root folder yang boleh dibaca template file. Kosong = /tmp
LLM_UTCP_FILE_ROOT=/tmp
